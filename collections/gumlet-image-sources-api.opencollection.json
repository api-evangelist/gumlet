{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gumlet Analytics Image Sources API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Image Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gumlet.com/v1/sources"
          },
          "docs": "List the image sources configured for the account."
        },
        {
          "info": {
            "name": "Create Source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gumlet.com/v1/sources",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an image source that connects an origin cloud storage bucket (S3, GCS, Spaces, Wasabi) or web folder to Gumlet optimization."
        },
        {
          "info": {
            "name": "Get Source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gumlet.com/v1/sources/:source_id",
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an image source configuration."
        },
        {
          "info": {
            "name": "Delete Source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.gumlet.com/v1/sources/:source_id",
            "params": [
              {
                "name": "source_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an image source."
        }
      ]
    }
  ],
  "bundled": true
}