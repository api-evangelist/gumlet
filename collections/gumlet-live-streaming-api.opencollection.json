{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gumlet Analytics Live Streaming API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Live Streaming",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Live Asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gumlet.com/v1/video/live/assets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a live streaming asset with an RTMP ingest endpoint and stream key, with optional live-to-VOD recording."
        },
        {
          "info": {
            "name": "Get Live Asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gumlet.com/v1/video/live/assets/:live_asset_id",
            "params": [
              {
                "name": "live_asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the status and details of a live asset."
        },
        {
          "info": {
            "name": "Delete Live Asset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.gumlet.com/v1/video/live/assets/:live_asset_id",
            "params": [
              {
                "name": "live_asset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a live streaming asset."
        }
      ]
    }
  ],
  "bundled": true
}